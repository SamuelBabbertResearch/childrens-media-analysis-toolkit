# Build output
dist/
build/
*.spec.bak

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/

# FFmpeg binaries (distributed separately in GitHub Release)
ffmpeg.exe
ffprobe.exe

# Analysis cache and database (user's personal data, not part of the app)
.analysis/

# Video files
*.mp4
*.avi
*.mkv
*.mov
*.wmv

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
test_report.pdf

# Scratch / dev files
Test.pyt
*.parts

# Media companion files (subtitle, metadata, etc.)
*.srt
*.nfo
*.jpg
*.png
*.nfo

# Generated static site (deployed separately to GitHub Pages)
_site/

# User show library (personal video data, not part of the app)
Shows/

# Duplicate episodes moved out of the library on 2026-08-15 (TODO.md item 0).
# Kept rather than deleted so the removal is reversible; nothing reads it.
_duplicates_quarantined_*/

# Release archives
*.zip

# Windows shortcuts
*.lnk

# Pilot / test run data
Pilot Trial Files/

# Docs wiki (managed separately)
docs/

# Private paper notes — unpublished results and draft framings. NEVER push.
FOR_PAPER.txt

# Per-user preferences: last opened folder (an absolute local path), startup
# window choices. config.json is versioned and shared; this is not.
user_prefs.json

# User-created pipeline documents (personal project data, not part of the app).
# Written next to the library when a root folder is set; this is the fallback.
pipelines/

# Validation detection caches — regenerable machine outputs (the .npz are large
# binaries); the coding, annotations, manifests, and .md docs ARE versioned.
*_framescores.npz
*_cuts_*.json

# Editor/OS junk
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
desktop.ini
.DS_Store
